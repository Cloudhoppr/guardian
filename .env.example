# Postgres (Neon free tier)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# CREAO — the agent provider. Get these at their table.
CREAO_API_URL=
CREAO_API_KEY=
CREAO_WEBHOOK_SECRET=

# CREAO saved agent IDs + per-agent app-scoped API keys (prefix: capi_).
# Create keys on the agent detail page in agent.creao.ai → Advanced → API Trigger.
# Guardian Purchaser: https://agent.creao.ai/apps/e60ae93c-e43c-428d-a31b-b8bde26b06ac
CREAO_PURCHASER_AGENT_ID=e60ae93c-e43c-428d-a31b-b8bde26b06ac
CREAO_PURCHASER_API_KEY=
CREAO_SCAM_SHIELD_AGENT_ID=d6d408af-c7d8-40e9-ae78-12a2b9c29d50
CREAO_SCAM_SHIELD_API_KEY=
CREAO_STATUS_UPDATER_AGENT_ID=7cccd992-1b61-4c4a-b7eb-f687a70f12c5
CREAO_STATUS_UPDATER_API_KEY=

# Shared secret CREAO's agent-run webhook includes as ?secret=... query param.
# Protects /api/creao/callback from random internet POSTs.
CREAO_CALLBACK_SECRET=

# Where callback webhookUrls point. Vercel preview URLs differ per branch,
# so set this to the production URL you want to receive callbacks at.
PUBLIC_BASE_URL=https://guardian-three-tau.vercel.app

# Photon — messaging transport (SMS/iMessage).
PHOTON_API_URL=https://api.photon.codes/v1
PHOTON_API_KEY=
PHOTON_SPACE_ID=
PHOTON_AGENT_USER_ID=

# ElevenLabs — voice. ELEVENLABS_WEBHOOK_SECRET gates /api/elevenlabs/call-ended
# so random internet traffic can't trigger the Purchaser agent.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_WEBHOOK_SECRET=
# ElevenLabs server tools (get_usual_items, check_scam, search_products) also
# send ELEVENLABS_WEBHOOK_SECRET as x-elevenlabs-secret. Native post-call
# webhooks are signed instead; pnpm elevenlabs:publish sets this one for you.
ELEVENLABS_POSTCALL_SIGNING_SECRET=
# Senior used when a voice call has no caller phone (dashboard/web-widget test
# calls). Leave unset in a real production deployment to disable.
ELEVENLABS_FALLBACK_MEMBER_ID=

# Instacart Developer Platform — intent-to-cart (not autonomous checkout).
# Leave blank for a mock URL so the dashboard still shows the flow.
INSTACART_API_KEY=
INSTACART_API_URL=https://connect.dev.instacart.tools

# Visa — payments. Leave blank to run in mock mode.
VISA_SANDBOX_KEY=

# Sentry.
SENTRY_DSN=

# Cron secret so only Vercel can hit /api/cron/*.
CRON_SECRET=

# Set to "1" when a real retailer is wired up and orders actually ship.
# Until then, status_update appends "[demo — not a real delivery]" to any
# message implying a real-world outcome (paid, delivery_scheduled). Prevents
# Grandma from being told "arrives Thursday" when nothing is shipping.
GUARDIAN_LIVE_RETAILER=

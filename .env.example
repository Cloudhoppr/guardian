# Postgres (Neon free tier)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# CREAO — the agent provider. Get these at their table.
CREAO_API_URL=
CREAO_API_KEY=
CREAO_WEBHOOK_SECRET=

# CREAO saved agent IDs. Set these in Vercel so /api/elevenlabs/call-ended
# knows which agent to trigger when a call ends. Public share URLs below for
# reference.
# Guardian Purchaser: https://agent.creao.ai/apps/e60ae93c-e43c-428d-a31b-b8bde26b06ac
CREAO_PURCHASER_AGENT_ID=e60ae93c-e43c-428d-a31b-b8bde26b06ac
CREAO_SCAM_SHIELD_AGENT_ID=

# Photon — messaging transport (SMS/iMessage).
PHOTON_API_URL=https://api.photon.codes/v1
PHOTON_API_KEY=
PHOTON_SPACE_ID=
PHOTON_AGENT_USER_ID=

# ElevenLabs — voice. ELEVENLABS_WEBHOOK_SECRET gates /api/elevenlabs/call-ended
# so random internet traffic can't trigger the Purchaser agent.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=
ELEVENLABS_WEBHOOK_SECRET=

# Instacart Developer Platform — intent-to-cart (not autonomous checkout).
# Leave blank for a mock URL so the dashboard still shows the flow.
INSTACART_API_KEY=
INSTACART_API_URL=https://connect.dev.instacart.tools

# Visa — payments. Leave blank to run in mock mode.
VISA_SANDBOX_KEY=

# Sentry.
SENTRY_DSN=

# Cron secret so only Vercel can hit /api/cron/*.
CRON_SECRET=

# Set to "1" when a real retailer is wired up and orders actually ship.
# Until then, status_update appends "[demo — not a real delivery]" to any
# message implying a real-world outcome (paid, delivery_scheduled). Prevents
# Grandma from being told "arrives Thursday" when nothing is shipping.
GUARDIAN_LIVE_RETAILER=
